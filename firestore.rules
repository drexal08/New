
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EZ Bus Security Rules Philosophy:
     * 1. Strict Ownership: Users have full control over their own profiles, bookings, and payments.
     * 2. Mutually Exclusive Roles: Operators can create trips; passengers cannot.
     * 3. Role-Based Access (DBAC): Administrative actions are gated by roles stored in profiles and specific role collections.
     * 4. Platform Admin: System-wide control gated by /roles_platform_admin.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_platform_admin/$(request.auth.uid));
    }

    function hasRole(userId, role) {
      return get(/databases/$(database)/documents/user_profiles/$(userId)).data.role == role;
    }

    function isOperator() {
      return isSignedIn() && hasRole(request.auth.uid, 'company');
    }

    function isPassenger() {
      return isSignedIn() && hasRole(request.auth.uid, 'passenger');
    }

    // --- Collection Rules ---

    match /user_profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        // Prevent role changing after creation unless admin
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) || isPlatformAdmin()
      );
      allow delete: if isPlatformAdmin();

      match /bookings/{bookingId} {
        allow get, list: if isOwner(userId) || isPlatformAdmin();
        allow create: if isOwner(userId) && isPassenger();
        allow update, delete: if isOwner(userId);

        match /payments/{paymentId} {
          allow get, list: if isOwner(userId) || isPlatformAdmin();
          allow create: if isOwner(userId);
          allow update, delete: if isPlatformAdmin();
        }
      }
    }

    match /transport_companies/{companyId} {
      allow get, list: if true;
      allow create: if isPlatformAdmin() || isOperator();
      allow update: if isPlatformAdmin() || isOperator();
      allow delete: if isPlatformAdmin();

      match /buses/{busId} {
        allow get, list: if true;
        allow create, update, delete: if isOperator() || isPlatformAdmin();
      }

      match /advertisements/{advertisementId} {
        allow get, list: if true;
        allow create, update, delete: if isOperator() || isPlatformAdmin();
      }
    }

    match /bus_parks/{busParkId} {
      allow get, list: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /routes/{routeId} {
      allow get, list: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /trips/{tripId} {
      allow get, list: if true;
      allow create: if isOperator() || isPlatformAdmin(); 
      allow update: if (isPlatformAdmin() || isOperator());
      allow delete: if isPlatformAdmin();
    }

    match /roles_platform_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }

    match /roles_company_admin/{companyId}/{userId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }
  }
}
