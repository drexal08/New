
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EZ Bus Security Rules Philosophy:
     * 1. System Admin Supremacy: Platform Admin (by email or role doc) has universal access.
     * 2. Strict Ownership: Passengers and Operators manage their own data.
     * 3. Role-Based Access: Operators manage trips/buses; Passengers manage bookings.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_platform_admin/$(request.auth.uid)) ||
        request.auth.token.email == 'byiringirinnocent8@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function isOperator() {
      return isSignedIn() && (getUserData().role == 'company' || isPlatformAdmin());
    }

    function isPassenger() {
      return isSignedIn() && (getUserData().role == 'passenger' || isPlatformAdmin());
    }

    // --- Universal Admin Access ---
    // Allow any operation if the user is a platform admin
    match /{document=**} {
      allow read, write: if isPlatformAdmin();
    }

    // --- Specific Collection Rules (for non-admins) ---

    match /user_profiles/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !('role' in request.resource.data) || request.resource.data.role == resource.data.role
      );

      match /bookings/{bookingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && getUserData().role == 'passenger';
        allow update, delete: if isOwner(userId);

        match /payments/{paymentId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId);
        }
      }
    }

    match /transport_companies/{companyId} {
      allow get, list: if true;
      allow create, update: if isOperator();

      match /buses/{busId} {
        allow get, list: if true;
        allow create, update, delete: if isOperator();
      }

      match /advertisements/{advertisementId} {
        allow get, list: if true;
        allow create, update, delete: if isOperator();
      }
    }

    match /bus_parks/{busParkId} {
      allow get, list: if true;
    }

    match /locations/{locationId} {
      allow get, list: if true;
    }

    match /routes/{routeId} {
      allow get, list: if true;
    }

    match /trips/{tripId} {
      allow get, list: if true;
      allow create, update: if isOperator();
    }

    match /roles_platform_admin/{userId} {
      allow get: if isSignedIn();
    }

    match /roles_company_admin/{companyId}/{userId} {
      allow get: if isSignedIn();
    }
  }
}
